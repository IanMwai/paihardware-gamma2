# /etc/pai-gamma2.conf - settings for the pai-run wrapper on gamma2.
# Every value has a default inside pai-run; set only what differs here.
# A per-user override can live in ~/.config/pai-gamma2.conf.

# libvirt name of the Windows VM that owns the NI USB-6341.
PAI_VM_NAME=daqwin
# Windows account inside the VM that runs acquisition (OpenSSH server, key auth).
PAI_VM_USER=daq
# Leave blank to look the VM's IP up from libvirt on every call (survives DHCP
# lease changes on the 192.168.122.0/24 NAT network); set to pin it.
PAI_VM_HOST=
# The `pai` entry point inside the VM (the venv of the clone there).
PAI_VM_PAI='C:\pai\paihardware-gamma2\.venv\Scripts\pai.exe'
# The `pai` entry point of the host-side clone (dashboard + archive, no DAQ).
PAI_HOST_PAI=/opt/pai/paihardware-gamma2/.venv/bin/pai
# Run folders. Served to the VM over Samba; must match PAI_OUTPUT_ROOT in both
# clones' .env (UNC path on the VM side).
PAI_OUTPUT_ROOT=/srv/pai/output
# Live dashboard served from gamma2 (0.0.0.0 = reachable from the lab network).
PAI_DASHBOARD_HOST=0.0.0.0
PAI_DASHBOARD_PORT=8000
