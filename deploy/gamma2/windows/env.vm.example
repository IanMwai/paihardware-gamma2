# .env for the clone INSIDE the daqwin VM (C:\pai\paihardware-gamma2\.env).
# Copy this file to that path as `.env`. Nothing here is a secret except that
# the key file it points at must stay inside the VM.

# Run folders live on gamma2, served over Samba (deploy/gamma2/host/smb-pai.conf).
# A UNC path, not a mapped drive letter: drive letters do not exist in the
# non-interactive SSH sessions gamma2 uses to start acquisition.
PAI_OUTPUT_ROOT=\\192.168.122.1\pai\output

# "gamma" is the host this VM runs on; 192.168.122.1 is always gamma2 as seen
# from inside the VM. NVML logging and the file fetch go over SSH with the key
# that setup-vm.ps1 generates (its public half goes into admin's
# authorized_keys on gamma2).
PAI_GAMMA_HOST=192.168.122.1
PAI_GAMMA_USER=admin
PAI_GAMMA_KEY_PATH=C:\Users\daq\.ssh\id_ed25519

# Archiving happens from gamma2 (the files are on its disk and Globus Connect
# Personal runs there), so the VM deliberately has no Globus endpoint: runs
# finish as ready_to_archive and the host's sweep timer pushes them.
#PAI_GLOBUS_LOCAL_ENDPOINT_ID=
