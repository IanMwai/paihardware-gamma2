# Per-machine / per-lab settings for pai-hardware.
# Copy this file to `.env` (same folder) and fill in the values for this
# machine. `.env` is gitignored — never commit it. Anything set here
# overrides configs/default.yaml; variables already set in the shell win
# over this file.

# UUID of THIS machine's Globus Connect Personal endpoint.
# Find it: GCP tray icon -> Web: Collection Details (or the Globus web app).
# Required for archive pushes; with it unset, runs simply stay local and
# `pai` prints how to archive them later.
PAI_GLOBUS_LOCAL_ENDPOINT_ID=

# UUID of the destination collection. The default in configs/default.yaml is
# the "Harvard FAS RC Holyoke" mapped collection (serves /n/holylabs) —
# uncomment and change only if your lab archives to a different collection.
#PAI_GLOBUS_REMOTE_ENDPOINT_ID=

# Archive destination path on the cluster. The default in configs/default.yaml
# is the Le Xie lab path; other labs set their own here, e.g.
#PAI_ARCHIVE_ROOT=/n/holylabs/<your_lab>/Lab/gpu_power_logs

# Where runs are written locally (default: output/ inside the project folder).
#PAI_OUTPUT_ROOT=output

# --- GPU workload machine ("gamma") ---
# SSH access so pai can run an NVML logger (nvidia-smi) on the machine driving
# the GPUs during each run and pull the files into the run folder. Leave these
# unset to disable the integration (runs never depend on gamma being up).
# Requires: pip install -e .[remote]
#PAI_GAMMA_HOST=
#PAI_GAMMA_USER=
# Auth: password, or (preferred once set up) a private key path.
#PAI_GAMMA_PASSWORD=
#PAI_GAMMA_KEY_PATH=

# Who starts runs from this machine, recorded in each manifest. Usually left
# unset: `pai hardware --operator` overrides it per run (default: your
# username).
#PAI_OPERATOR=

# --- The DAQ is in a VM on this machine (gamma2 host only) ---
# With these set, `pai hardware` starts acquisition inside the VM over SSH
# instead of locally; everything else (dashboard, stop, archive, menu) runs
# here. PAI_OUTPUT_ROOT must be the folder this host shares to the VM.
# Requires: pip install -e .[archive] here (no DAQ extras), ssh key for the VM.
#PAI_VM_NAME=daqwin                                   # libvirt name (IP looked up at run time)
#PAI_VM_HOST=                                         # or pin the VM's IP
#PAI_VM_USER=daqvnc1                                  # Windows account the key is authorised for
#PAI_VM_PAI=C:\pai\paihardware-gamma2\.venv\Scripts\pai.exe
# Dashboards bind this address; 0.0.0.0 makes them reachable from the network.
#PAI_DASHBOARD_HOST=0.0.0.0

# The clone INSIDE the VM uses deploy/gamma2/windows/env.vm.example instead
# (UNC output path on gamma2's share, gamma = 192.168.122.1).
